# Copier ce fichier en .env puis adapter les valeurs :
#   cp .env.example .env

# ===== Base de données (PostgreSQL) =====
# Ne pas utiliser "postgres" : Odoo refuse de se connecter avec ce compte
DB_USER=odoo
DB_PASSWORD=changeme

# ===== Version d'Odoo =====
# Version stable fixée (éviter "latest", qui peut tirer une version saas-* instable)
ODOO_VERSION=19.0

# ===== Port exposé sur la machine hôte =====
# 8070 (et non 8069) pour pouvoir tourner en même temps qu'un autre projet Odoo
ODOO_PORT=8070

# ===== Boîte de réception de test (Mailpit) =====
# Interface web des e-mails capturés : http://localhost:8025
MAILPIT_PORT=8025
