<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Acquisition mensuelle des congés payés : 1,5 jour par employé, le 1er de chaque mois -->
    <record id="ir_cron_monthly_accrual" model="ir.cron">
        <field name="name">Congés &amp; Absences : acquisition mensuelle (1,5 j)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_monthly_accrual()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=2, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
