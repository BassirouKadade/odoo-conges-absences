<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension du formulaire Employé : onglet « Congés » (visible par le RH) -->
    <record id="hr_employee_view_form_inherit_insea_leave" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.insea.leave</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="insea_leave" string="Congés"
                      groups="insea_hr_leave_custom.group_leave_hr">
                    <group>
                        <group string="Solde de congés payés">
                            <field name="leave_allocated"/>
                            <field name="leave_taken"/>
                            <field name="leave_balance" class="fw-bold"
                                   decoration-danger="leave_balance &lt;= 0"
                                   decoration-success="leave_balance &gt; 0"/>
                        </group>
                    </group>
                    <separator string="Acquisitions et ajustements"/>
                    <field name="accrual_ids">
                        <list editable="top">
                            <field name="date"/>
                            <field name="type"/>
                            <field name="days" sum="Total"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
