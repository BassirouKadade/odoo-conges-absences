<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Groupes de sécurité (Odoo 19 : rattachés à un res.groups.privilege).
        Hiérarchie : Employé ⊂ Manager ⊂ Responsable RH
        (chaque groupe hérite des droits du précédent via implied_ids).
        L'Administrateur système correspond au groupe standard base.group_system.
    -->
    <record id="res_groups_privilege_insea_leave" model="res.groups.privilege">
        <field name="name">Congés &amp; Absences</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_leave_employee" model="res.groups">
        <field name="name">Employé</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_insea_leave"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Crée, justifie et soumet ses propres demandes ; consulte son solde.</field>
    </record>

    <record id="group_leave_manager" model="res.groups">
        <field name="name">Manager (N+1)</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_insea_leave"/>
        <field name="implied_ids" eval="[Command.link(ref('group_leave_employee'))]"/>
        <field name="comment">Consulte, approuve ou refuse les demandes de son équipe.</field>
    </record>

    <record id="group_leave_hr" model="res.groups">
        <field name="name">Responsable RH</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_insea_leave"/>
        <!-- Le RH gère aussi les fiches employés (onglet Congés, soldes) : hr.group_hr_user -->
        <field name="implied_ids" eval="[Command.link(ref('group_leave_manager')), Command.link(ref('hr.group_hr_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Validation finale, gestion des soldes et paramétrage (administrateur fonctionnel).</field>
    </record>
</odoo>
